# ─────────────────────────────────────────────────────────────────────────────
# .env — instance configuration (non-secret). Copy to `.env`, or run
# `npm run setup`, which writes this file and `.env.local` for you.
#
# Vite loads `.env` first and `.env.local` on top of it, so anything set in both
# takes its `.env.local` value. Neither file is committed (see .gitignore).
# Secrets and keys belong in `.env.local` — template: `.env.local.example`.
# ─────────────────────────────────────────────────────────────────────────────

# Database + auth backend. LUMA runs on Supabase (Postgres + Auth + Storage);
# this records WHICH Supabase so the admin Setup tab can describe it.
#   supabase-cloud        — a project on supabase.com (default)
#   supabase-self-hosted  — your own Supabase stack (Docker / Kubernetes)
#   supabase-local        — `supabase start` on this machine, for development
LUMA_DB_PROVIDER=supabase-cloud

# Auth backend. Supabase Auth is the only one; extra sign-in methods (Google,
# Microsoft, GitHub, SAML…) are enabled as providers inside Supabase Auth.
LUMA_AUTH_PROVIDER=supabase

# Hosting target for `npm run build`:
#   vercel — Vercel serverless (default)
#   node   — a plain Node server (`node build`), for self-hosting and Docker
ADAPTER=vercel

# Public URL this deployment is served from. Used for Supabase Auth redirect
# URLs (Site URL, /auth/confirm, /auth/reset, /invite/*) and shown in Setup.
PUBLIC_APP_URL=http://localhost:5173

# PostHog ingest host (only used when PUBLIC_POSTHOG_KEY is set in .env.local).
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
